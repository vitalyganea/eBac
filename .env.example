APP_NAME=eBac
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Domeniul public. Din APP_URL se generează canonical-urile și sitemap-ul, deci
# în producție TREBUIE să fie https://ebac.md — altfel indexezi localhost.
SEO_DOMAIN=ebac.md
APP_LOCALE=ro
APP_FALLBACK_LOCALE=ro
APP_FAKER_LOCALE=ro_RO
# Aplicația rulează în UTC (vezi config/app.php). Fusul elevului e per-utilizator;
# fallback-ul e EBAC_DEFAULT_TIMEZONE.
EBAC_DEFAULT_TIMEZONE=Europe/Chisinau

# Versiunea minimă de aplicație mobilă acceptată de API (gate 426)
APP_MIN_MOBILE_VERSION=1.0.0

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=ebac
DB_USERNAME=ebac
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=20160
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6380

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@ebac.md"
MAIL_FROM_NAME="${APP_NAME}"

# Sanctum: domeniile care folosesc autentificare pe cookie (web).
# Mobilul folosește tokenuri, nu apare aici.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000

VITE_APP_NAME="${APP_NAME}"

# Autentificare cu Google (Google Cloud Console → Credentials → OAuth client ID).
# Tipul clientului: „Web application". URI-ul de redirecționare trebuie să fie
# exact cel de mai jos, altfel Google refuză cererea.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/intra/google/revenire"
